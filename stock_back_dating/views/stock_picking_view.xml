<odoo>

    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_done']" position="before">

                                <field name="is_effective" groups="stock_back_dating.group_backdating_manager"  attrs="{'readonly':[('state', 'in', ('done', 'cancel'))]}" />

				


            </xpath>
            <xpath expr="//field[@name='date_done']" position="replace">

                <field name="date_done" string="Effective Date" attrs="{'invisible':[('is_effective','=',True)],'readonly':[('state', 'in', ('done', 'cancel'))]}" groups='stock_back_dating.group_backdating_manager' />
                


			</xpath>
        </field>
    </record>
    

</odoo>


